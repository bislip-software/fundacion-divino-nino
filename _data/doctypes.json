  {
    "_id": "64a1c8e5f0b9c2b1d2e4f315",
    "name": "Sales Invoice",
    "caption": "Facturas",
    "autoname": "hash",
    "search_fields": "name,patient",
    "sort_field": "date",
    "sort_order": "desc",
    "in_desktop": true,
    "in_global_search": true,
    "is_table": false,
    "color": "#ffc107",
    "icon": "file-invoice-dollar",
    "fields": [
      {
        "field_name": "patient",
        "field_type": "Link",
        "label": "Paciente",
        "required": true,
        "options": "Patient | full_name | national_id",
        "in_list_view": true,
        "index": 1
      },
      {
        "field_name": "date",
        "field_type": "Date",
        "label": "Fecha",
        "required": false,
        "in_list_view": true,
        "index": 2
     },
      {
        "field_name": "time",
        "field_type": "Time",
        "label": "Hora",
        "required": false,
        "in_list_view": false,
        "index": 3
      },
    {
        "field_name": "currency_exchange",
        "field_type": "Link",
        "label": "Tipo de Cambio",
        "required": true,
        "options": "Currency Exchange | pair_name",
        "in_list_view": false,
        "index": 6
      },
      {
        "field_name": "services",
        "field_type": "Table",
        "label": "Servicios",
        "required": true,
        "options": "Sales Invoice Service",
        "in_list_view": false,
        "index": 4
      },
      {
        "field_name": "payments",
        "field_type": "Table",
        "label": "Pagos",
        "required": true,
        "options": "Sales Invoice Payment",
        "in_list_view": false,
        "index": 5
      },
      {
        "field_name": "exchange_rate",
        "field_type": "Number",
        "label": "Tasa de Cambio",
        "required": true,
        "in_list_view": false,
        "read_only": true,
        "depends_on": "currency_exchange",
        "fetch_from": "currency_exchange.exchange_rate",
        "index": 7
      },
      {
        "field_name": "total_usd",
        "field_type": "Number",
        "label": "Total USD",
        "required": true,
        "in_list_view": true,
        "read_only": true,
        "depends_on": "eval:doc.services.reduce((sum, service) => sum + (service.item.price || 0), 0)",
        "index": 8
      },
      {
        "field_name": "total_ves",
        "field_type": "Number",
        "label": "Total VES",
        "required": true,
        "in_list_view": true,
        "read_only": true,
        "depends_on": "eval:doc.total_usd * doc.exchange_rate",
        "index": 9
      },
      {
        "field_name": "total_paid_usd",
        "field_type": "Number",
        "label": "Total Pagado USD",
        "required": false,
        "in_list_view": false,
        "read_only": true,
        "depends_on": "eval:doc.payments.reduce((sum, payment) => sum + (payment.currency.symbol === 'USD' ? payment.amount : payment.currency.symbol === 'VES' ? (payment.amount / (doc.exchange_rate || 1)) : 0), 0)",
        "index": 10
      },
      {
        "field_name": "total_paid_ves",
        "field_type": "Number",
        "label": "Total Pagado VES",
        "required": false,
        "in_list_view": false,
        "read_only": true,
        "depends_on": "eval:doc.payments.reduce((sum, payment) => sum + (payment.currency.symbol === 'VES' ? payment.amount : (payment.currency.symbol === 'USD' ? (payment.amount * (doc.exchange_rate || 0)) : 0)), 0)",
        "index": 11
      },
      {
        "field_name": "paid",
        "field_type": "Check",
        "label": "Pagado",
        "required": false,
        "in_list_view": true,
        "read_only": true,
        "depends_on": "eval:(doc.total_paid_usd || 0) >= (doc.total_usd || 0) && (doc.total_paid_ves || 0) >= (doc.total_ves || 0)",
        "index": 12
